# Dashboard
# api url (see reverse proxy in nginx configuration)
BASE_URL=https://localhost/api
BASE_URL_SIMULATOR=https://localhost:8081/api
# host used in nginx configuration
HOST=localhost
# cert path with backslash at the end
# to start frontend on http 80 remove this line and change BASE_URL and ALLOWED_ORIGIN_PATTERNS protocol to http
CERT_PATH=/etc/letsencrypt/live/host-name/

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_NAME=f1interactive
DATABASE_SCHEMA=public
# ADMIN_PWD should be a bcrypt hash: https://bcrypt-generator.com/ (double $$)
ADMIN_PWD=$$2a$$10$$ipNTzBJBP5QQtewb6oPr/OWItptAuz/Rf7dcQEEFY5Gqpo39VIK2u

# Server
MAX_POOL_SIZE=3
ALLOWED_ORIGIN_PATTERNS=https://localhost

# Umami Analytics
UMAMI_SECRET=a_very_secure_secret_string_here
UMAMI_WEBSITE_ID=your-website-id-string

# VK App Configuration
VK_APP_ID=vk_app_id
VK_REDIRECT_URL=vk_redirect_url

